  "directed_sql": {
    "directed/variable-second": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INTEGER NOT NULL, epoch BIGINT, ts TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, id + 1, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, id + 1, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, id + 2, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/variable-month": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INTEGER NOT NULL, epoch BIGINT, ts TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(MONTH, id * 3, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(MONTH, id * 3, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(MONTH, id * 4, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/epoch": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INTEGER NOT NULL, epoch BIGINT, ts TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(MILLISECOND, CAST(epoch AS INT) + 10, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(MILLISECOND, CAST(epoch AS INT) + 10, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(MILLISECOND, CAST(epoch AS INT) + 11, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/seconds": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INTEGER NOT NULL, epoch BIGINT, ts TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CAST(epoch / 2 AS INT), ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CAST(epoch / 2 AS INT), ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CAST(epoch / 3 AS INT), ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/scaled-interval": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INTEGER NOT NULL, epoch BIGINT, ts TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (ts + INTERVAL '1' SECOND * (id + 1)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (ts + INTERVAL '1' SECOND * (id + 1)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (ts + INTERVAL '1' SECOND * (id + 2)) >= NOW() - INTERVAL '3' DAY AND id > 2;"
  },
