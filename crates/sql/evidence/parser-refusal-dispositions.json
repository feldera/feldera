  "grammar_gaps": {
    "qualified_datetime_difference": {
      "cases": 42,
      "proposed_repair": "Parse an explicitly qualified subtraction into a typed expression that retains the qualifier unit, optional precision and span in SELECT, CAST and window ordering. Leave ordinary aliases governed by the original alias grammar."
    },
    "create_type_field_nullability": {
      "cases": 9,
      "proposed_repair": "Parse explicit NULL and NOT NULL on named CREATE TYPE fields and retain the modifier on each field through AST emission."
    },
    "named_row_constructor_fields": {
      "cases": 7,
      "proposed_repair": "Add optional field aliases to ROW constructor elements, including nested constructors inside arrays and field access."
    },
    "grouped_unpivot": {
      "cases": 8,
      "proposed_repair": "Retain ordered tuple inputs and FOR columns and the values or tuple attached by each IN alias. Verify tuple arity before lowering."
    },
    "unicode_string_escape": {
      "cases": 8,
      "proposed_repair": "Defer U& string decoding until the optional UESCAPE clause has been consumed, retain its span, and implement Calcite-compatible pairing of supplementary Unicode escapes."
    },
    "range_symmetry": {
      "cases": 4,
      "proposed_repair": "Parse the BETWEEN symmetry modifier before the first bound and preserve it with the expression and any NOT modifier."
    },
    "grouping_distinct": {
      "cases": 4,
      "proposed_repair": "Consume DISTINCT as a grouping quantifier immediately after GROUP BY and preserve it on the grouping clause."
    },
    "limit_offset_first": {
      "cases": 4,
      "proposed_repair": "Support the offset-first LIMIT syntax while preserving the row-limit and offset roles, including ALL."
    },
    "rlike_null_operand": {
      "cases": 4,
      "proposed_repair": "Parse NULL as the right operand of RLIKE. Reserve IGNORE/RESPECT NULLS for the specified function and window contexts."
    },
    "nested_grouping_sets": {
      "cases": 2,
      "proposed_repair": "Parse grouping items recursively within GROUPING SETS and preserve nested structure, empty groups and repetition."
    },
    "wildcard_exclusion": {
      "cases": 3,
      "proposed_repair": "Disambiguate wildcard EXCEPT/EXCLUDE from set operators at the wildcard element and preserve qualified exclusion names in SELECT and ROW constructors."
    },
    "row_type_field_nullability": {
      "cases": 2,
      "proposed_repair": "Retain field nullability in ROW type declarations, including fields whose type is ARRAY or MAP, separately from the ROW's nullability."
    },
    "inline_foreign_key": {
      "cases": 1,
      "proposed_repair": "Accept the column-level FOREIGN KEY REFERENCES form in table DDL and attach it to the same field with its referenced columns and source span."
    },
    "map_query_constructor": {
      "cases": 1,
      "proposed_repair": "Parse MAP with an explicit query operand and retain it as a subquery constructor for binding."
    },
    "scalar_create_type": {
      "cases": 1,
      "proposed_repair": "Accept a datatype as the scalar alias body of CREATE TYPE and keep that body distinct from a structured type."
    },
    "double_slash_comment": {
      "cases": 1,
      "proposed_repair": "Recognize Calcite's double-slash line comments at lexer boundaries while preserving offsets and leaving quoted tokens intact."
    }
  },
