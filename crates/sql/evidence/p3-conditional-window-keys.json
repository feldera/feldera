  "directed_sql": {
    "directed/conditional-key-flag": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT NOT NULL, ts TIMESTAMP, alt TIMESTAMP, flag BOOLEAN, label VARCHAR);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN flag THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN flag THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN flag THEN 1 ELSE id END, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/conditional-key-string": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT NOT NULL, ts TIMESTAMP, alt TIMESTAMP, flag BOOLEAN, label VARCHAR);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN label = 'd\u00e9j\u00e0' THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN label = 'd\u00e9j\u00e0' THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN label = 'deja' THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/conditional-key-null": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT NOT NULL, ts TIMESTAMP, alt TIMESTAMP, flag BOOLEAN, label VARCHAR);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN label IS NULL THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN label IS NULL THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN label IS NOT NULL THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/conditional-key-nullable-flag": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT NOT NULL, ts TIMESTAMP, alt TIMESTAMP, flag BOOLEAN, label VARCHAR);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN NOT flag THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN NOT flag THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (TIMESTAMPADD(SECOND, CASE WHEN flag THEN id ELSE 1 END, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;"
