  "directed_sql": {
    "directed/hour": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT, ts TIMESTAMP, ts2 TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (ts + INTERVAL '1' HOUR) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (ts + INTERVAL '60' MINUTE) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (ts - INTERVAL '1' HOUR) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/month": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT, ts TIMESTAMP, ts2 TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (ts + INTERVAL '1' MONTH) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (ts + INTERVAL '1' MONTH) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (ts + INTERVAL '2' MONTH) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/two_columns": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT, ts TIMESTAMP, ts2 TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (GREATEST(ts, ts2)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (GREATEST(ts, ts2)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (GREATEST(ts2, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;",
    "directed/coalesce": "SET feldera_window_sharing_threshold = 2;\nCREATE TABLE t(id INT, ts TIMESTAMP, ts2 TIMESTAMP);\nCREATE VIEW v0 AS SELECT id FROM t WHERE (COALESCE(ts, ts2)) >= NOW() - INTERVAL '1' DAY AND id > 0;\nCREATE VIEW v1 AS SELECT id FROM t WHERE (COALESCE(ts, ts2)) >= NOW() - INTERVAL '2' DAY AND id > 1;\nCREATE VIEW v2 AS SELECT id FROM t WHERE (COALESCE(ts2, ts)) >= NOW() - INTERVAL '3' DAY AND id > 2;"
  },
