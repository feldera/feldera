#! /bin/sh -e

exit_status=0
# Cargo requires mod.rs for a module that integration tests or examples share.
for src in $(git ls-files -- '*/mod.rs' \
    ':!crates/sql/parser-probe/vendor/**' ':!crates/sql/*/tests/**' ':!crates/sql/*/examples/**')
do
    dst=$(echo "$src" | sed 's|/mod\.rs$|.rs|')
    echo "renaming $src to $dst to fit preferred style..."
    git mv "$src" "$dst"

    # The return value convention for this kind of script is that, if
    # it finds a problem, it should fix it and then return an error to
    # indicate that it did it.
    exit_status=1
done
exit $exit_status
