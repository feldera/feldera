{
  "name": "common-ui",
  "version": "0.0.1",
  "dependencies": {
    "common-lib": "workspace:*"
  },
  "devDependencies": {
    "@monaco-editor/loader": "1.7.0",
    "@skeletonlabs/skeleton": "^4.8.0",
    "@skeletonlabs/skeleton-svelte": "^4.9.0",
    "@svelte-bin/clipboard": "0.1.4",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "colorizr": "4.0.1",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "flowbite-svelte": "^1.31.0",
    "monaco-editor": "0.55.1",
    "paneforge": "1.0.2",
    "publint": "^0.3.15",
    "runed": "0.37.1",
    "strip-ansi": "7.1.2",
    "svelte": "5.57.3",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.17",
    "tiny-invariant": "1.3.3",
    "ts-pattern": "5.9.0",
    "typescript": "^6.0.0",
    "virtua": "0.48.6",
    "vite": "8.2.4"
  },
  "peerDependencies": {
    "@monaco-editor/loader": "1.7.0",
    "@skeletonlabs/skeleton-svelte": "^4.9.0",
    "@svelte-bin/clipboard": "0.1.4",
    "colorizr": "4.0.1",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "fancy-ansi": "^0.1.3",
    "flowbite-svelte": "^1.31.0",
    "monaco-editor": "0.55.1",
    "paneforge": "1.0.2",
    "runed": "0.37.1",
    "strip-ansi": "7.1.2",
    "svelte": "5.57.3",
    "tiny-invariant": "1.3.3",
    "ts-pattern": "5.9.0",
    "virtua": "0.48.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./statusTone": {
      "types": "./dist/statusTone.d.ts",
      "default": "./dist/statusTone.js"
    },
    "./healthStatus": {
      "types": "./dist/healthStatus.d.ts",
      "default": "./dist/healthStatus.js"
    },
    "./healthEvents": {
      "types": "./dist/healthEvents.d.ts",
      "default": "./dist/healthEvents.js"
    },
    "./pipelineHealth": {
      "types": "./dist/pipelineHealth.d.ts",
      "default": "./dist/pipelineHealth.js"
    },
    "./felderaRelation": {
      "types": "./dist/felderaRelation.d.ts",
      "default": "./dist/felderaRelation.js"
    },
    "./latencyColor": {
      "types": "./dist/latencyColor.d.ts",
      "default": "./dist/latencyColor.js"
    },
    "./connectorMetrics": {
      "types": "./dist/connectorMetrics.d.ts",
      "default": "./dist/connectorMetrics.js"
    }
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/**/*.spec.*"],
  "keywords": ["svelte"],
  "overrides": {
    "devalue": "^5.6.2"
  },
  "scripts": {
    "deps": "bun ../../scripts/check-bun-version.ts && bun run --filter common-lib build:self",
    "build": "bun run deps && bun run build:self",
    "build:self": "svelte-package && publint",
    "prepare": "bun run build:self",
    "check": "bun run deps && bun run check:self",
    "check:self": "svelte-check --threshold error",
    "check:watch": "bun run deps && svelte-check --threshold error --watch",
    "format": "biome check --write ."
  },
  "sideEffects": ["**/*.css"],
  "svelte": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts"
}
