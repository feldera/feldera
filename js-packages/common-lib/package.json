{
  "name": "common-lib",
  "version": "0.0.1",
  "description": "Framework-independent TypeScript utilities shared by the Feldera web packages",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./d3-random-bignumber": {
      "types": "./dist/d3-random-bignumber/index.d.ts",
      "default": "./dist/d3-random-bignumber/index.js"
    },
    "./valibot": {
      "types": "./dist/valibot/index.d.ts",
      "default": "./dist/valibot/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": ["dist", "!dist/**/*.spec.*"],
  "scripts": {
    "build": "bun run build:self",
    "build:self": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepare": "bun run clean && bun run build:self",
    "check": "bun run check:self",
    "check:self": "tsc --noEmit",
    "test": "vitest --run",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "bignumber.js": "9.3.1",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "tiny-invariant": "1.3.3",
    "valibot": "1.4.2",
    "worker-timers": "8.0.31"
  },
  "peerDependenciesMeta": {
    "bignumber.js": {
      "optional": true
    },
    "d3-format": {
      "optional": true
    },
    "dayjs": {
      "optional": true
    },
    "tiny-invariant": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "worker-timers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/d3-format": "3.0.4",
    "bignumber.js": "9.3.1",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "jsdom": "29.1.1",
    "tiny-invariant": "1.3.3",
    "typescript": "^5.9.3",
    "valibot": "1.4.2",
    "vitest": "^4.1.8",
    "worker-timers": "8.0.31"
  }
}
