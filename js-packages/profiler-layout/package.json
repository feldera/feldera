{
  "name": "profiler-layout",
  "version": "0.0.1",
  "scripts": {
    "deps": "bun ../../scripts/check-bun-version.ts && bun run --filter common-lib --filter triage-types --filter profiler-lib --filter common-ui build:self",
    "dev": "bun run deps && vite dev",
    "build": "bun run deps && bun run build:self",
    "build:self": "svelte-package && publint",
    "prepare": "svelte-kit sync && bun run build:self",
    "check": "bun run deps && bun run check:self",
    "check:self": "svelte-check --threshold error",
    "check:watch": "bun run deps && svelte-check --threshold error --watch",
    "test": "bun run deps && vitest --run",
    "test-watch": "bun run deps && vitest",
    "test-unit": "bun run deps && vitest --run --project unit --project component --project browser",
    "test-component": "bun run deps && vitest --run --project component",
    "format": "biome check --write ."
  },
  "files": ["dist", "!dist/**/*.test.*", "!dist/**/*.spec.*", "!dist/test-support/**"],
  "sideEffects": ["**/*.css"],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "dependencies": {
    "but-unzip": "^0.1.7",
    "common-ui": "workspace:*",
    "paneforge": "1.0.2",
    "profiler-lib": "workspace:*",
    "sort-on": "^7.0.0",
    "triage-types": "workspace:*"
  },
  "peerDependencies": {
    "@monaco-editor/loader": "1.7.0",
    "@svelte-bin/clipboard": "0.1.4",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "monaco-editor": "0.55.1",
    "runed": "0.37.1",
    "strip-ansi": "7.1.2",
    "svelte": "5.55.7",
    "tiny-invariant": "1.3.3",
    "virtua": "0.48.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@monaco-editor/loader": "1.7.0",
    "@skeletonlabs/skeleton": "^4.8.0",
    "@skeletonlabs/skeleton-svelte": "^4.9.0",
    "@svelte-bin/clipboard": "0.1.4",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.49.5",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@vitest/browser-playwright": "^4.1.8",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "feldera-theme": "workspace:*",
    "monaco-editor": "0.55.1",
    "playwright": "1.58.2",
    "publint": "^0.3.15",
    "svelte": "5.55.7",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "8.2.0",
    "vitest": "^4.1.8",
    "vitest-browser-svelte": "^2.1.1"
  },
  "overrides": {
    "devalue": "^5.6.2"
  },
  "keywords": ["svelte"]
}
