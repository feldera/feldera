{
  "name": "profiler-lib",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run build:self",
    "build:self": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "bun run clean && tsc --noCheck",
    "check": "bun run check:self",
    "check:self": "tsc --noEmit",
    "test": "vitest --run"
  },
  "keywords": ["feldera", "profiler", "visualization", "dbsp"],
  "author": "",
  "license": "MIT",
  "description": "Reusable library for visualizing Feldera DBSP circuit profiles",
  "dependencies": {
    "common-lib": "workspace:*"
  },
  "peerDependencies": {
    "cytoscape": "^3.35.0",
    "cytoscape-dblclick": "^0.3.1",
    "cytoscape-elk": "^2.3.0",
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "elkjs": "^0.11.0"
  },
  "devDependencies": {
    "d3-format": "3.1.2",
    "dayjs": "1.11.19",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  }
}
